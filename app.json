{
  "expo": {
    "name": "SplitIt",
    "slug": "splitit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "splitit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "ai.neocrew.splitit",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "upi"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2b2f8f",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "ai.neocrew.splitit",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "SplitIt",
      "shortName": "SplitIt",
      "themeColor": "#2b2f8f",
      "backgroundColor": "#f5f5fb"
    },
    "plugins": [
      "expo-router",
      "@sentry/react-native",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2b2f8f",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "SplitIt uses the camera to scan restaurant bills.",
          "photosPermission": "SplitIt reads photos of bills you choose to scan."
        }
      ],
      "./plugins/withUpiQueries.js",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true,
      "baseUrl": "/splitit-claude"
    }
  }
}
